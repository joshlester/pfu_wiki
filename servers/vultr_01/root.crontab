# (Cron version -- $Id: crontab.c,v 2.13 1994/01/17 03:20:37 vixie Exp $)
# Edit this file to introduce tasks to be run by cron.
# 
# Each task to run has to be defined through a single line
# indicating with different fields when the task will be run
# and what command to run for the task
# 
# To define the time you can provide concrete values for
# minute (m), hour (h), day of month (dom), month (mon),
# and day of week (dow) or use '*' in these fields (for 'any').# 
# Notice that tasks will be started based on the cron's system
# daemon's notion of time and timezones.
# 
# Output of the crontab jobs (including errors) is sent through
# email to the user the crontab file belongs to (unless redirected).
# 
# For example, you can run a backup of all your user accounts
# at 5 a.m every week with:
# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/
# 
# For more information see the manual pages of crontab(5) and cron(8)
# 
# m h  dom mon dow   command

# Backup DB every night at 00:00
0 0 * * * /bin/bash /srv/www/josh_wiki/scripts/backup.sh 2>&1 /srv/www/josh_wiki/logs/cron_db_backup.log

##
# Stocks Dataklip - ASX
##

# Pull ASX entities at 20:10 NY time. 10 mins post after hours trading.
10 9 * * 1-5 wget -a /srv/www/stocks_dataklip/logs/stocks_dataklip.log -O /dev/null --read-timeout 900 --post-data "" 'https://stocks.dataklip.com/v1/entities?exchange=ASX'

# Pull ASX ticks at 20:20 NY time. 10 mins post after hours trading.
20 9 * * 1-5 wget -a /srv/www/stocks_dataklip/logs/stocks_dataklip.log -O /dev/null --read-timeout 900 --post-data "" 'https://stocks.dataklip.com/v1/stock-ticks?exchange=ASX'

##
# Stocks Dataklip - NASDAQ & NYSE
##

# Pull NASDAQ & NYSE entities at 20:10 NY time. 10 mins post after hours trading.
05 0 * * 1-5 wget -a /srv/www/stocks_dataklip/logs/stocks_dataklip.log -O /dev/null --read-timeout 900 --post-data "" 'https://stocks.dataklip.com/v1/entities?exchange=NASDAQ'
07 0 * * 1-5 wget -a /srv/www/stocks_dataklip/logs/stocks_dataklip.log -O /dev/null --read-timeout 900 --post-data "" 'https://stocks.dataklip.com/v1/entities?exchange=NYSE'

# Pull NASDAQ & NYSE ticks at 20:20 NY time. 10 mins post after hours trading.
09 0 * * 1-5 wget -a /srv/www/stocks_dataklip/logs/stocks_dataklip.log -O /dev/null --read-timeout 900 --post-data "" 'https://stocks.dataklip.com/v1/stock-ticks?exchange=NASDAQ'
25 0 * * 1-5 wget -a /srv/www/stocks_dataklip/logs/stocks_dataklip.log -O /dev/null --read-timeout 900 --post-data "" 'https://stocks.dataklip.com/v1/stock-ticks?exchange=NYSE'

